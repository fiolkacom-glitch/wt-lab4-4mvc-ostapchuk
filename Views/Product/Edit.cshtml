@model wt_lab4_4mvc_ostapchuk.Models.Product

@{
    ViewData["Title"] = "Редактировать";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded-0 border-top border-warning border-3">
        <div class="card-body">
            <h2 class="mb-4 text-dark fw-bold text-uppercase">Редактировать товар</h2>
            
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-bold"></label>
                    <input asp-for="Category" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-bold"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label fw-bold"></label>
                </div>

                <button type="submit" class="btn btn-warning rounded-0 fw-bold px-4">Сохранить изменения</button>
                <a asp-action="Index" class="btn btn-outline-dark rounded-0 px-4">Назад</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}