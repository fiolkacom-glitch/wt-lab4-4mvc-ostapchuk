@{
    ViewData["Title"] = "Главная";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #111 0%, #2a2a2a 100%);
        color: white;
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hero-title {
        font-size: 5rem;
        font-weight: 900;
        color: #e60000;
        text-transform: uppercase;
        line-height: 1;
        letter-spacing: -2px;
    }
    .hero-subtitle {
        font-size: 1.5rem;
        color: #b0b0b0;
        letter-spacing: 2px;
    }
    .btn-red {
        background-color: #e60000;
        color: white;
        border: none;
        font-weight: 700;
        text-transform: uppercase;
        padding: 15px 40px;
        font-size: 1.2rem;
        transition: 0.3s;
    }
    .btn-red:hover {
        background-color: #ff1a1a;
        color: white;
        transform: scale(1.05);
    }
</style>

<div class="container mt-4">
    <div class="hero-section text-center">
        <div>
            <h1 class="hero-title mb-3">СПОРТИВНЫЙ<br>КЛУБ</h1>
            <p class="hero-subtitle mb-5">БУДЬ В ФОРМЕ — С НАМИ</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-red rounded-0">
                Перейти в каталог
            </a>
        </div>
    </div>
</div>